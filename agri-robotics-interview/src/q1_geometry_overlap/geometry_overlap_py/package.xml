<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>geometry_overlap_py</name>
  <version>0.1.0</version>
  <description>
    Interview exercise: compare/overlap geometries reported by an internal
    geometry provider node (field boundary, restricted zone, tractor implement
    footprint), using Shapely for the geometric math. Python version.
  </description>
  <maintainer email="jason.lambert@sabantoag.com">Jason Lambert</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <!--
    shapely (>= 2.0) is intentionally not declared here as a rosdep key:
    the apt packaged python3 shapely on Ubuntu 22.04 is an older 1.x
    release whose STRtree API differs from 2.0 (see geometry_types.py).
    Install via pip instead, per the top level README.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
